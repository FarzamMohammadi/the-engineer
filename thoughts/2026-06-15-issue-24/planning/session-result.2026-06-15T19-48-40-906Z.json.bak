{
  "status": "ok",
  "summary": "Plan complete: diff-digest change-detection gate + a diff-derived pr-title.md deliverable + updatePR wiring in the rework path, all reusing existing infra; verified against source, stress-tested, with an ordered test-backed implementation.",
  "details": {
    "decisions": [
      {
        "category": "architecture",
        "summary": "Detect 'did the PR change' via a sha256 digest of the diff-against-base, stored on the task, instead of comparing regenerated prose or reading the live PR body from the host.",
        "chosen": "Add IWorkspaceManager.diffDigestAgainstBase(taskId) and a nullable ReviewState.presented_diff_digest field; the rework path pushes title+body via the existing updatePR only when the current digest differs from the stored one.",
        "reasoning": "The body/title are LLM-generated, so string comparison fires on no-op reworks (the spurious update the owner asked to avoid); the host doesn't expose its current body. A diff digest is the faithful, deterministic, testable reading of the owner's 'regenerate when the code changes, push what changed.' Reading the live body would mean extending the adapter contract and every hosting plugin for no gain. The change is additive: review is a JSON column, so no DB migration.",
        "details": { "new_interface_methods": 1, "new_schema_fields": 1, "sql_migrations": 0 }
      },
      {
        "category": "architecture",
        "summary": "Make the PR title a diff-derived deliverable (pr-title.md) generated by pr-description, and source it identically in both the new-PR and rework paths.",
        "chosen": "pr-description writes a single-line whole-PR title to pr-title.md; create-pr composes the title from it (falling back to the task title when absent) at both creation and update.",
        "reasoning": "The owner widened scope so the title must always represent the whole PR (not the frozen task title), and AC#4 wants creation consistent with how updates are generated so the first re-push doesn't spuriously rewrite an unchanged title. Side effect worth confirming: newly-opened PRs will get an LLM-generated title instead of the raw task title.",
        "details": { "new_deliverable_files": 1 }
      }
    ]
  }
}
