{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "all": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noNodejsModules": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noConsoleLog": "error"
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "off"
      },
      "style": {
        "noDefaultExport": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "strictCase": true,
            "filenameCases": ["kebab-case"]
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              { "selector": { "kind": "function" }, "formats": ["camelCase", "PascalCase"] },
              { "selector": { "kind": "typeLike" }, "formats": ["PascalCase"] },
              {
                "selector": { "kind": "variable" },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              { "selector": { "kind": "enumMember" }, "formats": ["PascalCase"] },
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "snake_case", "CONSTANT_CASE"]
              },
              {
                "selector": { "kind": "typeProperty" },
                "formats": ["camelCase", "snake_case"]
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "semicolons": "always",
      "quoteStyle": "double"
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "overrides": [
    {
      "include": ["vitest.*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "include": ["src/dashboard/client/vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "include": ["src/dashboard/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noReactSpecificProps": "off",
            "noConsole": "off",
            "noConsoleLog": "off"
          },
          "correctness": {
            "useImportExtensions": "off",
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "include": ["tests/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noDelete": "off",
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noExplicitAny": "off",
            "noConsole": "off",
            "noConsoleLog": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "noNamespaceImport": "off",
            "useNamingConvention": "off",
            "useThrowOnlyError": "off"
          }
        }
      }
    },
    {
      "include": ["scripts/**/*.ts", "scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noConsoleLog": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": ["dist", "coverage", "node_modules", "~", ".claude"]
  }
}
