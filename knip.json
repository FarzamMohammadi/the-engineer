{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/adapters/index.ts",
    "src/schemas/*.ts",
    "src/core/observer/logging.ts",
    "src/core/orchestrator/types.ts",
    "src/core/safety-layer/errors.ts",
    "src/core/task-engine/errors.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignore": ["src/dashboard/client/**"],
  "ignoreDependencies": [
    "pino-pretty",
    "pino-roll",
    "@types/node-fetch",
    "tailwindcss",
    "react-router",
    "recharts",
    "lucide-react",
    "class-variance-authority",
    "tw-animate-css",
    "@radix-ui/react-scroll-area",
    "@radix-ui/react-separator",
    "@radix-ui/react-slot",
    "@radix-ui/react-tooltip",
    "@radix-ui/react-tabs"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": ["unresolved"],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "off",
    "unlisted": "error",
    "binaries": "error",
    "exports": "warn",
    "types": "warn",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "error",
    "enumMembers": "off"
  }
}
