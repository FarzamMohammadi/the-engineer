{
  "name": "the-engineer",
  "version": "0.0.1",
  "description": "Autonomous software engineering agent",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "engineer": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown src/index.ts --format esm && cp -r src/db/migrations dist/migrations && pnpm run build:dashboard",
    "build:dashboard": "vite build --config src/dashboard/client/vite.config.ts",
    "dev": "tsx src/index.ts",
    "dev:dashboard": "vite --config src/dashboard/client/vite.config.ts",
    "lint": "biome check . && tsc --noEmit && tsc --noEmit -p tsconfig.test.json && knip && madge --circular --extensions ts src/",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:exports": "knip",
    "check:circular": "madge --circular --extensions ts src/"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@inquirer/prompts": "^8.4.3",
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^11.9.1",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "grammy": "^1.42.0",
    "hono": "^4.12.18",
    "ms": "^2.1.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "ulid": "^2.3.0",
    "yaml": "^2.8.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ms": "^2.1.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "knip": "^6.12.2",
    "lefthook": "^1.11.13",
    "lucide-react": "^1.14.0",
    "madge": "^8.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.12.5",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.12",
    "vitest": "^3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "better-sqlite3", "esbuild", "lefthook"]
  }
}
