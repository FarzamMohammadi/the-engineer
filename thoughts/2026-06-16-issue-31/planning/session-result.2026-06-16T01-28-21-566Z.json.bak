{
  "status": "ok",
  "summary": "Plan complete: single workflow_dispatch release.yml (gh CLI + npm version + atomic git push) gated by CI, plus docs; verified branch-protection/version facts live. One owner action (RELEASE_PAT secret) surfaced as a recorded security decision, not a blocker.",
  "details": {
    "chosen_approach": "Single .github/workflows/release.yml using gh CLI --generate-notes + npm version --no-git-tag-version + atomic git commit/tag push; no new dependencies or third-party actions.",
    "files_to_create": [
      ".github/workflows/release.yml",
      "docs/contribution-docs/how-tos/release.md"
    ],
    "files_to_edit": [
      "docs/.vitepress/config.ts",
      "docs/contribution-docs/README.md",
      "README.md",
      "CONTRIBUTING.md (optional pointer)"
    ],
    "owner_action_required_before_first_run": "Create a fine-grained PAT (repo: the-engineer, Contents: Read & write) and store it as the RELEASE_PAT Actions secret. Needed because main requires PRs and the default GITHUB_TOKEN (github-actions[bot]) cannot push to protected main; the owner PAT (admin, enforce_admins:false) bypasses it.",
    "next_clean_release": "v1.0.2 (package.json is 1.0.1; main is 3 commits ahead of v1.0.1)",
    "decisions": [
      {
        "category": "security",
        "summary": "Use an owner-scoped RELEASE_PAT Actions secret to push the version-bump commit past main's required-PR branch protection.",
        "chosen": "Fine-grained PAT (this repo, Contents: Read & write) stored as RELEASE_PAT; used by actions/checkout and gh.",
        "reasoning": "main requires a PR with 1 approval and require_last_push_approval; enforce_admins is false and the default GITHUB_TOKEN runs as github-actions[bot] (not admin, not in any bypass list), so it cannot push the bump commit. An owner PAT acts as the admin and bypasses protection. Chosen over (a) adding a branch-protection bypass for github-actions[bot] which loosens protection for all bot workflows, and (b) a GitHub App which is overkill for a single-maintainer repo. The owner pre-delegated the mechanism choice to Planning; recording here so the autonomy policy can confirm the credential strategy. Not a blocker: execution writes the full workflow + docs now; the secret is a one-time owner setup step before the first run.",
        "details": { "alternatives_rejected": 2 }
      },
      {
        "category": "test_coverage",
        "summary": "Include ci.yml's bundled-docs sync check in the release gate, mirroring CI's lint job exactly (gate = lint + bundled-docs sync + unit test + build, not test:all).",
        "chosen": "Run pnpm lint + docs:bundle/git-diff sync check + pnpm test + pnpm build before any mutation.",
        "reasoning": "Requirements settled the gate as lint + unit test + build (mirror CI), not test:all. The bundled-docs sync check is part of CI's required 'lint' job; including it makes the release gate faithfully equal to what keeps main green, at trivial cost and already proven on every push.",
        "details": {}
      },
      {
        "category": "scope_expansion",
        "summary": "Add an optional dry_run boolean input to the workflow (gate + version/notes preview, no commit/tag/release).",
        "chosen": "dry_run input, default false; when true the job ends after computing the version and previewing notes.",
        "reasoning": "Directly satisfies acceptance criterion 10 branch 1 (validate without publishing a throwaway release) at the cost of a small if: branch. Honest caveat documented: a dry run cannot prove the protected-main push/auth, which only the first real run validates.",
        "details": { "new_inputs": 1 }
      }
    ]
  }
}
