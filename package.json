{
  "name": "the-engineer",
  "version": "0.0.1",
  "description": "Autonomous software engineering agent",
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "engineer": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown src/index.ts --format esm",
    "dev": "tsx src/index.ts",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0",
    "ms": "^2.1.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "ulid": "^2.3.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/ms": "^2.1.0",
    "@vitest/coverage-v8": "^3.1.4",
    "lefthook": "^1.11.13",
    "tsdown": "^0.12.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "better-sqlite3", "esbuild", "lefthook"]
  }
}
